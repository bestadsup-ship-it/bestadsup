# ============================================================================
# BestAdsUp - Environment Variables Template
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!
#
# Quick start: cp .env.example .env
# ============================================================================

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# PostgreSQL connection string
# Format: postgresql://[user[:password]@][host][:port][/database]
DATABASE_URL=postgresql://localhost:5432/bestadsup

# For production (example):
# DATABASE_URL=postgresql://prod_user:securepassword@db.example.com:5432/bestadsup_prod

# Connection pool settings (optional)
DB_POOL_MIN=2
DB_POOL_MAX=10

# ============================================================================
# JWT AUTHENTICATION
# ============================================================================
# Secret for signing JWT access tokens (REQUIRED)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-256-bit-secret-here-change-this-in-production

# Secret for signing refresh tokens (REQUIRED)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_REFRESH_SECRET=your-refresh-token-secret-here-change-this-too

# Token expiration times
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

# ============================================================================
# STRIPE PAYMENT PROCESSING
# ============================================================================
# Get test keys from: https://dashboard.stripe.com/test/apikeys
# Get live keys from: https://dashboard.stripe.com/apikeys

# Stripe secret key (backend only)
STRIPE_SECRET_KEY=sk_test_51...

# Stripe publishable key (frontend)
STRIPE_PUBLISHABLE_KEY=pk_test_51...

# Webhook signing secret (get after creating webhook endpoint)
# Dashboard → Developers → Webhooks → Add endpoint
# Endpoint URL: https://api.bestadsup.com/api/v1/webhooks/stripe
# Events: payment_intent.succeeded, charge.refunded, transfer.paid, payout.paid
STRIPE_WEBHOOK_SECRET=whsec_...

# Platform fee configuration (% of transaction)
PLATFORM_FEE_PERCENT=15
BUYER_FEE_PERCENT=10
CREATOR_FEE_PERCENT=5

# Auto-release escrow after X days (if no dispute)
ESCROW_AUTO_RELEASE_DAYS=14

# ============================================================================
# GOOGLE OAUTH (For Google Analytics 4 Verification)
# ============================================================================
# Get credentials from: https://console.cloud.google.com
# 1. Create project
# 2. Enable "Google Analytics API"
# 3. Create OAuth 2.0 Client ID (Web application)
# 4. Add authorized redirect URI

GOOGLE_CLIENT_ID=123456789-abcdefghijklmnopqrstuvwxyz.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxx

# Redirect URI (must match Google Cloud Console exactly)
# Development:
GOOGLE_REDIRECT_URI=http://localhost:3005/verification/callback
# Production:
# GOOGLE_REDIRECT_URI=https://app.bestadsup.com/verification/callback

# Scopes (space-separated)
GOOGLE_SCOPES=https://www.googleapis.com/auth/analytics.readonly profile email

# ============================================================================
# HUBSPOT API (Phase 2 - Optional for MVP)
# ============================================================================
# Get credentials from: https://developers.hubspot.com
# Used for lead generation verification

HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=http://localhost:3005/verification/hubspot/callback

# ============================================================================
# EMAIL SERVICE (SendGrid)
# ============================================================================
# Sign up at: https://sendgrid.com
# Settings → API Keys → Create API Key

SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=noreply@bestadsup.com
SENDGRID_FROM_NAME=BestAdsUp

# Email templates (optional - for transactional emails)
SENDGRID_WELCOME_TEMPLATE_ID=
SENDGRID_PASSWORD_RESET_TEMPLATE_ID=
SENDGRID_PROJECT_NOTIFICATION_TEMPLATE_ID=

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
# Environment (development, staging, production)
NODE_ENV=development

# Backend API port
PORT=3002
CONTROL_PLANE_PORT=3002

# Frontend port
DASHBOARD_PORT=3005

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3005

# API base URL (used by frontend)
API_BASE_URL=http://localhost:3002/api/v1

# ============================================================================
# REDIS (Optional - for caching & sessions)
# ============================================================================
# Optional for development, recommended for production
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================================================
# SECURITY & RATE LIMITING
# ============================================================================
# Rate limiting (requests per window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Password hashing (bcrypt rounds)
BCRYPT_ROUNDS=12

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3005,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3005,http://localhost:3000

# Cookie settings
COOKIE_SECRET=your-cookie-secret-here
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ============================================================================
# FILE UPLOAD (AWS S3 or Local Storage)
# ============================================================================
# Storage type: 'local' or 's3'
STORAGE_TYPE=local

# Local storage path (if STORAGE_TYPE=local)
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# AWS S3 Configuration (if STORAGE_TYPE=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=bestadsup-uploads
AWS_REGION=us-east-1
AWS_S3_BASE_URL=https://bestadsup-uploads.s3.amazonaws.com

# ============================================================================
# OPTIONAL INTEGRATIONS
# ============================================================================

# ----------------------------------------------------------------------------
# Sentry (Error Tracking)
# ----------------------------------------------------------------------------
# Sign up at: https://sentry.io
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ----------------------------------------------------------------------------
# Mixpanel (Product Analytics)
# ----------------------------------------------------------------------------
# Sign up at: https://mixpanel.com
MIXPANEL_TOKEN=

# ----------------------------------------------------------------------------
# Google Analytics (Frontend Tracking)
# ----------------------------------------------------------------------------
GA_TRACKING_ID=

# ----------------------------------------------------------------------------
# Intercom (Customer Support Chat)
# ----------------------------------------------------------------------------
INTERCOM_APP_ID=

# ============================================================================
# FEATURE FLAGS
# ============================================================================
# Enable/disable features for gradual rollout

# Enable verification system (Phase 1)
FEATURE_VERIFICATION_ENABLED=true

# Enable escrow payments (Phase 1)
FEATURE_ESCROW_ENABLED=true

# Enable project milestones (Phase 1)
FEATURE_MILESTONES_ENABLED=true

# Enable HubSpot verification (Phase 2)
FEATURE_HUBSPOT_VERIFICATION=false

# Enable Creator Pro subscriptions (Phase 2)
FEATURE_CREATOR_PRO=false

# Enable promoted posts (Phase 2)
FEATURE_PROMOTED_POSTS=false

# ============================================================================
# LOGGING
# ============================================================================
# Log level: 'error', 'warn', 'info', 'debug'
LOG_LEVEL=info

# Log format: 'json' or 'pretty'
LOG_FORMAT=pretty

# ============================================================================
# CRON JOBS & BACKGROUND TASKS
# ============================================================================
# Enable background jobs (auto-approve milestones, auto-release escrow)
ENABLE_CRON_JOBS=true

# Auto-approve milestones after X days of submission
AUTO_APPROVE_MILESTONE_DAYS=7

# Sync verification data interval (minutes)
VERIFICATION_SYNC_INTERVAL_MINUTES=60

# ============================================================================
# DEVELOPMENT & TESTING
# ============================================================================
# Seed database with test data on startup (development only)
SEED_TEST_DATA=false

# Mock external API calls (for testing without real API keys)
MOCK_STRIPE_API=false
MOCK_GOOGLE_API=false
MOCK_HUBSPOT_API=false

# Test mode (skips certain validations)
TEST_MODE=false

# ============================================================================
# PRODUCTION-ONLY SETTINGS
# ============================================================================
# Uncomment and configure these for production deployment

# SSL/TLS
# FORCE_HTTPS=true
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem

# Database SSL
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Helmet security headers
# ENABLE_HELMET=true

# Trust proxy (if behind load balancer)
# TRUST_PROXY=true

# ============================================================================
# NOTES
# ============================================================================
# 1. NEVER commit .env to version control
# 2. Use strong, randomly generated secrets for production
# 3. Rotate secrets regularly (every 90 days recommended)
# 4. Use different credentials for dev/staging/prod environments
# 5. Store production secrets in secure vault (AWS Secrets Manager, etc.)
#
# Quick Commands:
# - Generate JWT secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# - Test database connection: psql $DATABASE_URL
# - Validate env vars: npm run validate:env
# ============================================================================
