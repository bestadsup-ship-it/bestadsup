{
  "name": "bestadsup",
  "version": "1.0.0",
  "description": "BestAdsUp - Verified Performance Marketing Marketplace for SaaS",
  "private": true,
  "workspaces": [
    "services/control-plane",
    "packages/shared",
    "packages/dashboard"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=services/control-plane\" \"npm run dev --workspace=packages/dashboard\"",
    "dev:backend": "npm run dev --workspace=services/control-plane",
    "dev:frontend": "npm run dev --workspace=packages/dashboard",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "npm run build --workspace=services/control-plane",
    "build:frontend": "npm run build --workspace=packages/dashboard",
    "start": "npm run start --workspace=services/control-plane",
    "test": "npm run test --workspaces --if-present",
    "test:backend": "npm run test --workspace=services/control-plane",
    "test:frontend": "npm run test --workspace=packages/dashboard",
    "migrate": "node scripts/run-all-migrations.js",
    "migrate:verify": "psql $DATABASE_URL -c \"SELECT table_name FROM information_schema.tables WHERE table_schema='public' ORDER BY table_name;\"",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "db:create": "createdb bestadsup",
    "db:drop": "dropdb bestadsup",
    "db:reset": "npm run db:drop && npm run db:create && npm run migrate",
    "postinstall": "echo '✅ Dependencies installed. Run \"npm run dev\" to start development servers.'"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "prettier": "^3.1.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/bestadsup.git"
  },
  "keywords": [
    "saas",
    "marketing",
    "marketplace",
    "verification",
    "performance-marketing",
    "escrow"
  ],
  "author": "BestAdsUp Team",
  "license": "UNLICENSED"
}
